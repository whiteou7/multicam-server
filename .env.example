PORT=3000
HOST=0.0.0.0

JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

DATABASE_PATH=./data/multicam.sqlite3

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=multicam-videos

MAX_FILE_SIZE_BYTES=1073741824
CHUNK_SIZE_BYTES=5242880
UPLOAD_TMP_DIR=./data/upload-tmp
UPLOAD_SESSION_TTL_MS=21600000
DOWNLOAD_URL_TTL_SECONDS=600

# Ghi tự động khi phát sóng (ffmpeg transcode VP8→H264 ghi MP4)
SERVER_RECORDING_ON=true
SERVER_RECORDING_UPLOAD=true
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
RECORDINGS_TMP_DIR=./data/recordings-tmp
# Dưới ngưỡng này coi như file không có frame (chỉ header) → không upload/insert
RECORDING_MIN_BYTES=10000
