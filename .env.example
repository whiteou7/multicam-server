# Copy to .env. docker compose reads it; also used by `npm run dev`.
# [cloud] = must be set for a cloud deploy.

PORT=3000
HOST=0.0.0.0

JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

DATABASE_PATH=./data/multicam.sqlite3

# MinIO (compose points the backend at the minio service itself; these 3 are
# also the MinIO root credentials)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=multicam-videos

# [cloud] Public S3 host clients use for presigned URLs, e.g. s3.example.com
MINIO_PUBLIC_ENDPOINT=
# Optional, defaults to 443 (ssl) or 80
MINIO_PUBLIC_PORT=
MINIO_PUBLIC_USE_SSL=true

# [cloud] Allowed browser origins, comma separated, e.g. https://api.example.com (empty = allow any)
CORS_ORIGINS=

# [cloud, REQUIRED by docker-compose] VM public IP announced in WebRTC candidates
MEDIASOUP_ANNOUNCED_IP=
MEDIASOUP_RTC_MIN_PORT=40100
MEDIASOUP_RTC_MAX_PORT=40199

# Docker image tag for `docker compose pull` (default: latest)
# TAG=latest

MAX_FILE_SIZE_BYTES=1073741824
UPLOAD_SESSION_TTL_MS=21600000
DOWNLOAD_URL_TTL_SECONDS=600
